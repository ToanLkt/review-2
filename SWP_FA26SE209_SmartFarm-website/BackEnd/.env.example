# File mẫu biến môi trường cho Backend.
# Cách dùng: copy file này thành `.env` (cùng thư mục BackEnd) rồi điền giá trị thật.
#   cp .env.example .env
# File `.env` ĐÃ bị gitignore nên KHÔNG commit lên git — không bao giờ đặt secret thật vào .env.example.

# --- JWT ---
JWT_SECRET=local-docker-secret-key-change-before-production

# --- Gmail SMTP (để GỬI MAIL THẬT: xác nhận email, quên mật khẩu) ---
# Nếu để TRỐNG SMTP_USER hoặc SMTP_PASSWORD, hệ thống chạy chế độ LOG (in mã OTP/token ra terminal, không gửi mail thật).
# SMTP_PASSWORD phải là Gmail App Password (tạo tại https://myaccount.google.com/apppasswords, cần bật 2FA), KHÔNG phải mật khẩu Gmail thường.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=SmartFarm

# --- SePay (webhook thanh toán) ---
SEPAY_WEBHOOK_SECRET=
SEPAY_BANK_NAME=
# Mã BIN ngân hàng theo chuẩn VietQR/Napas (vd Vietcombank=970436, MBBank=970422, ACB=970416). BẮT BUỘC để tạo mã VietQR.
SEPAY_BANK_BIN=
SEPAY_BANK_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=

# --- OSRM (đo khoảng cách giao hàng) ---
OSRM_ENABLED=true
OSRM_BASE_URL=http://osrm:5000
OSRM_PROFILE=driving
OSRM_TIMEOUT_SECONDS=10

# --- Cloudflare R2 (Lưu trữ ảnh camera khay rau) ---
CLOUDFLARE_R2_ENABLED=true
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET_NAME=smartfarm-camera
CLOUDFLARE_R2_API_TOKEN=
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://pub-7dfeb459c49842f69ca547ad3bb40357.r2.dev
